# Dart / Flutter build tooling — regenerated by `pub get` / `flutter pub get`
# and bakes in absolute local machine paths (pub-cache location, etc.), so
# never track it.
.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies
build/

# Flutter-generated native scaffolding that's machine/toolchain-specific.
**/windows/flutter/ephemeral/
**/windows/flutter/generated_plugin_registrant.*
**/windows/flutter/generated_plugins.cmake
**/linux/flutter/ephemeral/
**/macos/Flutter/ephemeral/

# IDE
.vscode/
.idea/
*.iml

# OS
Thumbs.db
.DS_Store

# Vendored binaries are shipped separately (installer time), not committed.
/vendor/adb/*
/vendor/scrcpy/*
!/vendor/adb/.gitkeep
!/vendor/scrcpy/.gitkeep

# Project context doc for AI assistants — not for the public repo.
CLAUDE.md
CLaude.md

# Not ready to publish yet.
/packages/ui/
